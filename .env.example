# Runtime paths used by the public demo
AJC_RUNTIME_ROOT=runtime
AJC_REFERENCE_ROOT=examples/reference
AJC_CV_ROOT=examples/cv
AJC_SOURCE_EXPORT_ROOT=examples/source_exports
AJC_MAX_DOCUMENT_BYTES=20971520
AJC_OCR_DPI=300
AJC_OCR_LANGUAGE=fra+eng

# Optional remote connectors. Empty by default.
# Every remote hostname must also appear in AJC_ALLOWED_REMOTE_HOSTS.
AJC_ALLOWED_REMOTE_HOSTS=
QUEST_EXPORT_URLS=
NOCRM_EXPORT_URL=
NOCRM_API_KEY=
BEETWEEN_EXPORT_URL=
BEETWEEN_BEARER_TOKEN=

# Optional Microsoft Graph / OneDrive publication
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_USER_PRINCIPAL_NAME=
MS_GRAPH_REMOTE_FOLDER=

# Docker bind-mount ownership
AJC_UID=1000
AJC_GID=1000
